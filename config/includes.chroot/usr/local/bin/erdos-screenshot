#!/bin/sh
set -eu
umask 077
directory="$HOME/Pictures/Screenshots"
mkdir -p "$directory"
file="$directory/Screenshot-$(date +%Y-%m-%d_%H-%M-%S-%N).png"
case "${1:-full}" in
    full) grim "$file" ;;
    region) geometry=$(slurp) || exit 0; grim -g "$geometry" "$file" ;;
    geometry) [ "$#" = 2 ] || exit 2; grim -g "$2" "$file" ;;
    *) echo 'Usage: erdos-screenshot [full|region|geometry GEOMETRY]' >&2; exit 2 ;;
esac
