#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""ErdOS Settings: one GTK window, existing system tools, no background service."""
import sys
from pathlib import Path
sys.dont_write_bytecode = True
settings_lib = Path(__file__).resolve().parent.parent / 'lib/erdos'
if not (settings_lib / 'settings.py').is_file():
    settings_lib = Path('/usr/local/lib/erdos')
sys.path.insert(0, str(settings_lib))
import settings as backend

if '--apply-session' in sys.argv:
    try:
        backend.apply_session()
    except Exception as error:
        print(f'ErdOS settings: {error}', file=sys.stderr)
    sys.exit(0)

import configparser
import json
import subprocess
import time
from datetime import datetime
from zoneinfo import ZoneInfo
import display_settings
import threading
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, Gio, GLib


class Settings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.erdos.Settings',
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option('network', 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             'Open the Network tab', None)
        self.window = None
        self.groups = []
        self.busy = False

    def do_command_line(self, command_line):
        self.activate()
        if command_line.get_options_dict().contains('network'):
            self.stack.set_visible_child_name('Network')
        return 0

    def do_activate(self):
        if self.window:
            self.window.present(); return
        self.window = Gtk.ApplicationWindow(application=self, title='ErdOS Settings')
        self.window.set_default_size(880, 640)
        self.groups = []
        self.window.set_size_request(640, 420)
        self.window.connect('delete-event', self.close_requested)
        self.window.connect('destroy', lambda *_: setattr(self, 'window', None))
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body = Gtk.Box()
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)
        self.stack.set_hexpand(True)
        sidebar = Gtk.StackSidebar(stack=self.stack)
        sidebar.set_size_request(175, -1)
        sidebar.get_accessible().set_name('Settings sections')
        body.pack_start(sidebar, False, False, 0)
        body.pack_start(self.stack, True, True, 0)
        self.status = Gtk.Label(xalign=0, wrap=True, selectable=True)
        self.status.set_margin_start(16); self.status.set_margin_end(16)
        self.status.set_margin_top(10); self.status.set_margin_bottom(10)
        outer.pack_start(body, True, True, 0)
        self.feedback = Gtk.InfoBar(show_close_button=True)
        self.progress = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.progress.set_no_show_all(True)
        self.feedback.get_content_area().pack_start(self.progress, False, False, 0)
        self.feedback.get_content_area().pack_start(self.status, True, True, 0)
        self.feedback.connect('response', lambda *_: self.feedback.hide())
        self.feedback.set_no_show_all(True)
        outer.pack_start(self.feedback, False, False, 0)
        self.resolution_bar = Gtk.Box(spacing=12)
        self.resolution_bar.set_border_width(12)
        self.resolution_label = Gtk.Label(xalign=0, wrap=True)
        self.resolution_label.set_max_width_chars(45)
        self.resolution_bar.pack_start(self.resolution_label, True, True, 0)
        for label, answer in [('Revert', 'revert'), ('Keep resolution', 'keep')]:
            button = Gtk.Button(label=label)
            button.connect('clicked', lambda _, answer=answer: self.answer_resolution(answer))
            self.resolution_bar.pack_start(button, False, False, 0)
        outer.pack_start(self.resolution_bar, False, False, 0)
        self.trial_process = None
        self.trial_timer = None
        self.window.add(outer)
        for name in ('Appearance', 'Default Programs', 'Touchpad', 'Keyboard', 'Overview Dock', 'Menu', 'Startup Applications', 'Gestures', 'Displays', 'Sound', 'Network', 'Bluetooth', 'Power', 'Date & Time'):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            page.set_border_width(28)
            title = Gtk.Label(xalign=0); title.set_markup(f'<span size="x-large" weight="bold">{GLib.markup_escape_text(name)}</span>')
            page.pack_start(title, False, False, 0)
            scroll = Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            scroll.add(page); self.stack.add_titled(scroll, name, name)
            scroll.get_accessible().set_name(name + ' settings')
            try:
                getattr(self, name.lower().replace(' & ', '_').replace(' ', '_'))(page)
            except Exception as error:
                self.note(page, f'Could not load this section: {self.error_text(error)}')
        self.window.show_all()
        self.resolution_bar.hide()

    def note(self, page, text):
        label = Gtk.Label(label=text, xalign=0, wrap=True)
        label.set_max_width_chars(62)
        if len(text) > 190:
            details = Gtk.Expander(label='More information')
            label.set_margin_top(8)
            details.add(label)
            page.pack_start(details, False, False, 0)
        else:
            page.pack_start(label, False, False, 0)
        return label

    def row(self, page, title, widget):
        children = page.get_children()
        frame = children[-1] if children else None
        if not isinstance(frame, Gtk.Frame) or not hasattr(frame, 'settings_rows'):
            frame = Gtk.Frame(shadow_type=Gtk.ShadowType.IN)
            frame.settings_rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            frame.add(frame.settings_rows)
            page.pack_start(frame, False, False, 0)
        row = Gtk.ListBoxRow(activatable=False, selectable=False)
        box = Gtk.Box(spacing=20)
        box.set_border_width(12)
        label = Gtk.Label(label=title, xalign=0, wrap=True)
        label.set_max_width_chars(32)
        label.set_mnemonic_widget(widget)
        widget.get_accessible().set_name(title)
        if isinstance(widget, Gtk.Entry): widget.set_width_chars(22)
        widget.set_valign(Gtk.Align.CENTER)
        box.pack_start(label, True, True, 0)
        box.pack_end(widget, False, False, 0)
        row.add(box); frame.settings_rows.add(row)
        return widget

    @staticmethod
    def widgets(root):
        yield root
        if isinstance(root, Gtk.Container):
            for child in root.get_children():
                yield from Settings.widgets(child)

    def close_requested(self, *_):
        if self.trial_process is not None:
            self.close_after_resolution = True
            self.answer_resolution('revert')
            return True
        dirty = [g for g in self.groups if self.group_values(g) != g['saved']]
        if dirty or self.busy:
            dialog = Gtk.MessageDialog(transient_for=self.window, modal=True,
                message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                text='Close Settings?')
            dialog.format_secondary_text('Unsaved edits will be discarded.' if dirty else
                'The change already started will finish in the background.')
            dialog.add_buttons('Keep editing', Gtk.ResponseType.CANCEL, 'Close', Gtk.ResponseType.OK)
            dialog.set_default_response(Gtk.ResponseType.CANCEL)
            answer = dialog.run(); dialog.destroy()
            return answer != Gtk.ResponseType.OK
        return False

    @staticmethod
    def control_value(widget):
        if isinstance(widget, Gtk.Switch): return widget.get_active()
        if isinstance(widget, Gtk.ComboBox): return widget.get_active_id()
        if isinstance(widget, Gtk.SpinButton): return widget.get_value()
        if isinstance(widget, Gtk.Entry): return widget.get_text()
        if isinstance(widget, Gtk.FontButton): return widget.get_font_name()
        if isinstance(widget, Gtk.ColorButton): return widget.get_rgba().to_string()
        if isinstance(widget, Gtk.FileChooserButton): return widget.get_filename()
        if isinstance(widget, Gtk.TreeView): return [tuple(row) for row in widget.get_model()]
        if isinstance(widget, Gtk.TextView):
            buf=widget.get_buffer(); return buf.get_text(buf.get_start_iter(),buf.get_end_iter(),False)

    def group_values(self, group):
        return [self.control_value(w) for w in group['controls']]

    def group_update(self, group, *_):
        dirty = self.group_values(group) != group['saved']
        group['hint'].set_markup('<b>Unsaved changes</b>' if dirty else '')
        group['apply'].set_sensitive(dirty and not self.busy and group.get('available',lambda:True)())
        group['revert'].set_sensitive(dirty and not self.busy)

    def group_revert(self, group):
        for w,value in zip(group['controls'],group['saved']):
            if isinstance(w, Gtk.Switch): w.set_active(value)
            elif isinstance(w, Gtk.ComboBox): w.set_active_id(value)
            elif isinstance(w, Gtk.SpinButton): w.set_value(value)
            elif isinstance(w, Gtk.Entry): w.set_text(value)
            elif isinstance(w, Gtk.FontButton): w.set_font_name(value)
            elif isinstance(w, Gtk.ColorButton):
                color=Gdk.RGBA(); color.parse(value); w.set_rgba(color)
            elif isinstance(w, Gtk.FileChooserButton):
                w.set_filename(value) if value else w.unselect_all()
            elif isinstance(w, Gtk.TreeView):
                model=w.get_model(); model.clear()
                for row in value: model.append(row)
            elif isinstance(w, Gtk.TextView):
                w.get_buffer().set_text(value); w.get_buffer().set_modified(False)
        self.group_update(group)

    def reset_groups(self, page):
        for group in self.groups:
            if group['page'] is page:
                group['saved']=self.group_values(group); self.group_update(group)

    def toggle(self, page, title, active):
        return self.row(page, title, Gtk.Switch(active=active, valign=Gtk.Align.CENTER))

    def scale(self, page, title, low, high, value, step=1):
        widget = Gtk.SpinButton.new_with_range(low, high, step)
        widget.set_value(value)
        return self.row(page, title, widget)

    def choice(self, page, title, values, active=None):
        widget = Gtk.ComboBoxText()
        for key, label in values:
            widget.append(str(key), label)
        if active is not None:
            widget.set_active_id(str(active))
        if widget.get_active() < 0:
            widget.set_active(0)
        return self.row(page, title, widget)

    def button(self, page, title, action):
        button = Gtk.Button(label=title, halign=Gtk.Align.START)
        group=None
        if title.startswith(('Apply ', 'Save startup')):
            previous = {id(child) for g in self.groups if g['page'] is page for w in g['controls'] for child in self.widgets(w)}
            candidates=list(self.widgets(page))
            controls=[w for w in candidates if id(w) not in previous and isinstance(w,
                (Gtk.Switch,Gtk.ComboBox,Gtk.SpinButton,Gtk.FontButton,Gtk.ColorButton,Gtk.FileChooserButton,Gtk.TreeView,Gtk.TextView))]
            # Entries inside composite controls are owned by that control.
            for w in candidates:
                if not isinstance(w,Gtk.Entry) or w in controls or id(w) in previous: continue
                parent=w.get_parent()
                while parent is not None and parent not in controls: parent=parent.get_parent()
                if parent is None and id(w) not in previous: controls.append(w)
            group={'page':page,'controls':controls,'apply':button,'hint':Gtk.Label(xalign=0),'revert':Gtk.Button(label='Revert')}
            group['saved']=self.group_values(group)
            self.groups.append(group)
            bar=Gtk.Box(spacing=8)
            bar.pack_start(group['hint'],True,True,0)
            bar.pack_end(button,False,False,0)
            bar.pack_end(group['revert'],False,False,0)
            button.set_label('Save' if title.startswith('Save') else 'Apply')
            button.get_style_context().add_class('suggested-action')
            button.set_tooltip_text(title)
            group['revert'].connect('clicked',lambda *_: self.group_revert(group))
            def changed(*_): self.group_update(group)
            for w in controls:
                if isinstance(w,Gtk.TreeView):
                    for signal in ('row-changed','row-inserted','row-deleted','rows-reordered'): w.get_model().connect(signal,changed)
                elif isinstance(w,Gtk.TextView): w.get_buffer().connect('changed',changed)
                elif isinstance(w,Gtk.Switch): w.connect('notify::active',changed)
                elif isinstance(w,Gtk.FontButton): w.connect('font-set',changed)
                elif isinstance(w,Gtk.ColorButton): w.connect('color-set',changed)
                elif isinstance(w,Gtk.FileChooserButton): w.connect('file-set',changed)
                elif isinstance(w,Gtk.SpinButton): w.connect('value-changed',changed)
                else: w.connect('changed',changed)
            page.pack_start(bar,False,False,0)
            self.group_update(group)
        else:
            page.pack_start(button,False,False,0)
        button.connect('clicked', lambda *_: self.perform(action, group=group))
        return button

    def report(self, message, error=False, busy=False):
        self.status.set_text(message)
        self.status.get_accessible().set_description(message)
        self.progress.start() if busy else self.progress.stop()
        self.progress.set_visible(busy)
        self.feedback.set_message_type(Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO)
        self.status.show()
        self.feedback.get_content_area().show()
        self.feedback.show()

    @staticmethod
    def error_text(error):
        if isinstance(error, subprocess.TimeoutExpired):
            return 'The operation timed out. Check the device or connection and try again.'
        if isinstance(error, FileNotFoundError):
            return f'Required program or file is missing: {error.filename or error}'
        message = getattr(error, 'message', str(error)).strip()
        # BlueZ and other D-Bus services prefix otherwise useful error messages.
        if 'GDBus.Error:' in message:
            message = message.split('GDBus.Error:', 1)[1].split(':', 1)[-1].strip()
        return message or 'The operation could not be completed. Try again.'

    def perform(self, action, pending='Applying…', group=None):
        if self.busy:
            self.report('Another change is still being applied. Please wait.'); return
        try:
            job = action()
        except Exception as error:
            self.report(self.error_text(error), error=True); return
        if not callable(job):
            if group:
                group['saved']=self.group_values(group); self.group_update(group)
            if isinstance(job,str): self.report(job)
            return
        window=self.window
        self.busy=True; self.hold()
        if group: group['page'].set_sensitive(False)
        for g in self.groups: self.group_update(g)
        self.report(pending, busy=True)
        def worker():
            try:
                result=job()
                message=result if isinstance(result,str) and result else 'Changes applied.'
                failed=False
            except Exception as error:
                message=self.error_text(error); failed=True
            GLib.idle_add(finish,message,failed)
        def finish(message,failed):
            self.busy=False
            if self.window is window:
                if group:
                    group['page'].set_sensitive(True)
                    if not failed: group['saved']=self.group_values(group)
                for g in self.groups: self.group_update(g)
                self.report(message,error=failed)
            elif self.window is not None:
                for g in self.groups: self.group_update(g)
            self.release()
            return False
        threading.Thread(target=worker,daemon=True).start()

    def selection_actions(self, tree, actions):
        tree.get_accessible().set_name('Editable settings list')
        def update(*_):
            model, row = tree.get_selection().get_selected()
            index = model.get_path(row).get_indices()[0] if row is not None else -1
            for button, step in actions:
                button.set_sensitive(index >= 0 and (step is None or 0 <= index + step < len(model)))
        tree.get_selection().connect('changed', update)
        for signal in ('row-inserted', 'row-deleted', 'rows-reordered'): tree.get_model().connect(signal, update)
        update()

    def edit_fields(self, title, fields, commit):
        dialog=Gtk.Dialog(title=title,transient_for=self.window,modal=True)
        dialog.add_buttons('Cancel',Gtk.ResponseType.CANCEL,'Save',Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box=dialog.get_content_area(); box.set_border_width(18); box.set_spacing(12)
        entries=[]
        for label,value in fields:
            entry=Gtk.Entry(text=value,activates_default=True); entry.set_width_chars(32)
            caption=Gtk.Label(label=label,xalign=0); caption.set_mnemonic_widget(entry)
            entry.get_accessible().set_name(label)
            box.pack_start(caption,False,False,0)
            box.pack_start(entry,False,False,0); entries.append(entry)
        dialog.show_all()
        if dialog.run()==Gtk.ResponseType.OK: commit([e.get_text() for e in entries])
        dialog.destroy()

    def appearance(self, page):
        parser = configparser.ConfigParser(interpolation=None)
        parser.read(backend.CONFIG / 'gtk-3.0/settings.ini')
        values = parser['Settings'] if parser.has_section('Settings') else {}
        themes = {'Adwaita'}
        for root in (Path('/usr/share/themes'), Path.home() / '.themes', Path.home() / '.local/share/themes'):
            themes.update(p.parent.name for p in root.glob('*/gtk-3.0') if p.is_dir())
        current = values.get('gtk-theme-name', 'Adwaita'); themes.add(current)
        theme = self.choice(page, 'Application theme', [(t,t) for t in sorted(themes)], current)
        font = self.row(page, 'Font', Gtk.FontButton(font=values.get('gtk-font-name', 'DejaVu Sans 10')))
        dark = self.toggle(page, 'Prefer dark appearance', backend.prefers_dark(values.get('gtk-application-prefer-dark-theme') == 'true'))
        prefs = backend.preferences()
        rgba = Gdk.RGBA(); rgba.parse(prefs['background'])
        color = self.row(page, 'Desktop color', Gtk.ColorButton(rgba=rgba))
        mode = self.choice(page, 'Background', [('solid', 'Solid color'), ('image', 'Image')],
                           'image' if prefs['background_image'] else 'solid')
        image_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12)
        page.pack_start(image_box,False,False,0)
        chooser = Gtk.FileChooserButton(title='Choose a background image', action=Gtk.FileChooserAction.OPEN)
        image_filter = Gtk.FileFilter(); image_filter.set_name('Images'); image_filter.add_pixbuf_formats()
        chooser.add_filter(image_filter)
        self.row(image_box, 'Choose image', chooser)
        image_status = self.note(image_box, '')
        layout = self.choice(image_box, 'Image layout', [('fill','Fill (crop to fit)'), ('fit','Fit (keep whole image)'),
                             ('center','Center'), ('tile','Tile')], prefs['background_layout'])
        remove = Gtk.Button(label='Remove image', halign=Gtk.Align.START)
        image_box.pack_start(remove, False, False, 0)
        def refresh(*_):
            enabled = mode.get_active_id() == 'image'
            if enabled:
                image_box.set_no_show_all(False); image_box.show_all()
            else: image_box.hide()
            image_box.set_no_show_all(True)
            chooser.set_sensitive(enabled); layout.set_sensitive(enabled)
            remove.set_sensitive(enabled)
            if enabled:
                filename = chooser.get_filename()
                if filename:
                    message = Path(filename).name
                elif backend.wallpaper_path().is_file():
                    message = 'Saved image selected.'
                elif backend.DEFAULT_WALLPAPER.is_file():
                    message = 'Default ErdOS wallpaper selected.'
                else:
                    message = 'Choose an image.'
                image_status.set_text(message)
            else: image_status.set_text('Solid color selected.')
        def selected(*_):
            if chooser.get_filename():
                mode.set_active_id('image')
                image_status.set_text(Path(chooser.get_filename()).name)
        chooser.connect('file-set', selected)
        def clear(*_):
            chooser.unselect_all(); mode.set_active_id('solid')
            image_status.set_text('Solid color selected. Apply to remove the saved image.')
        remove.connect('clicked', clear)
        mode.connect('changed', refresh); refresh()
        self.note(image_box, 'Apply to save a private copy of the image and restore it at login. Remove image returns to your desktop color when applied; the original file is never deleted. Fill crops without stretching; Fit uses your desktop color around the image.')
        self.note(page, 'Firefox and supported websites follow this light/dark preference when set to use the system theme. Other themes and fonts may require reopening an app.')
        def apply():
            c = color.get_rgba(); hexcolor = '#%02x%02x%02x' % tuple(round(v*255) for v in (c.red,c.green,c.blue))
            args = (theme.get_active_id(), font.get_font_name(), dark.get_active(), hexcolor,
                    mode.get_active_id() == 'image', layout.get_active_id(), chooser.get_filename())
            def job():
                backend.appearance(*args)
                window=self.window
                def saved():
                    if self.window is not window or not chooser.get_parent(): return False
                    Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme',args[2])
                    chooser.unselect_all()
                    image_status.set_text('Saved image selected.' if args[4] else 'No image selected.')
                GLib.idle_add(saved)
            return job
        self.button(page, 'Apply appearance', apply)

    def default_programs(self, page):
        import default_apps
        self.note(page, 'These choices control the desktop menu and app shortcuts, plus web links, folders and plain-text files.')
        fields = {}
        for role, (label, *_rest) in default_apps.ROLES.items():
            fields[role] = self.row(page, label, Gtk.ComboBoxText())
        def refresh():
            if any(g['page'] is page and self.group_values(g)!=g['saved'] for g in self.groups):
                self.report('Apply or revert your default-app edits before refreshing.',error=True); return
            for role, widget in fields.items():
                rows, selected = default_apps.choices(role)
                widget.remove_all()
                for key, name in rows:
                    widget.append(key, name)
                widget.set_active_id(selected or '')
                if not rows:
                    widget.append('', 'No application installed')
                    widget.set_active(0)
                widget.set_sensitive(bool(rows))
            self.reset_groups(page)
        refresh()
        button = Gtk.Button(label='Refresh application list', halign=Gtk.Align.START)
        button.connect('clicked', lambda *_: refresh())
        page.pack_start(button, False, False, 0)
        def apply():
            selections = {role: widget.get_active_id() for role, widget in fields.items() if widget.get_sensitive()}
            return lambda: default_apps.set_defaults(selections)
        self.button(page, 'Apply default programs', apply)
        self.note(page, 'Install an alternative first, then refresh this list. Terminal selection is per user; System terminal follows the computer’s terminal setting. Other file types keep their own associations. These choices apply immediately; no logout is needed.')

    def touchpad(self, page):
        prefs = backend.preferences()
        natural = self.toggle(page, 'Natural scrolling', prefs['natural'])
        self.note(page, 'When enabled, moving fingers up moves the page content down.')
        tap = self.toggle(page, 'Tap to click', prefs['tapping'])
        click = self.toggle(page, 'Two-finger click for right-click', prefs['clickfinger'])
        speed = self.scale(page, 'Pointer speed', -1, 1, prefs['speed'], .1)
        self.note(page, 'Applies to libinput touchpads now and automatically when connected.')
        def apply():
            values = dict(natural=natural.get_active(), tapping=tap.get_active(),
                          clickfinger=click.get_active(), speed=speed.get_value())
            return lambda: backend.touchpad(backend.save_preferences(**values))
        self.button(page, 'Apply touchpad settings', apply)

    def keyboard(self, page):
        prefs = backend.preferences()
        dynamic = self.toggle(page, 'Dynamic workspaces', prefs['dynamic_workspaces'])
        count = self.scale(page, 'Fixed workspace count', 1,32,prefs['workspace_count'])
        count.set_sensitive(not dynamic.get_active())
        dynamic.connect('notify::active',lambda *_: count.set_sensitive(not dynamic.get_active()))
        super_key = self.toggle(page, 'Tap Super to toggle the window overview', prefs['super_overview'])
        self.note(page, 'Dynamic mode keeps one spare after the last occupied or current workspace. Empty gaps keep their numbers; only trailing workspaces disappear. Fixed mode never removes a workspace containing windows or the current workspace.')
        def apply_workspaces():
            values = dict(dynamic_workspaces=dynamic.get_active(), workspace_count=count.get_value_as_int(), super_overview=super_key.get_active())
            def job():
                backend.save_preferences(**values)
                backend.run('labwc','--reconfigure')
            return job
        self.button(page, 'Apply workspace and Super-key settings', apply_workspaces)
        self.note(page, 'Select a shortcut and choose Edit, or double-click it. Separate alternatives with a comma. Fn mode is controlled by your keyboard.')
        keyboard_source=backend.keyboard_source()
        model = Gtk.ListStore(str, str)
        labels={'ShowMenu root-menu':'Desktop menu','ShowMenu client-list-combined-menu':'Workspaces menu','NextWindow':'Cycle windows forward','PreviousWindow':'Cycle windows backward','erdos-screenshot':'Take a screenshot','ErdosScreenshotWindow':'Screenshot focused window','erdos-screenshot region':'Screenshot selected area','Unmaximize':'Restore window','Maximize':'Maximize window','Iconify':'Minimize window','Close':'Close window', 'ErdosOverview':'Window overview', 'ErdosPreviousWindow':'Previous window', 'ErdosNextWindow':'Next window', 'erdos-settings':'Settings', 'erdos-launch browser':'Default browser', 'erdos-launch files':'Default file manager', 'erdos-launch editor':'Default text editor', 'erdos-launch terminal':'Default terminal'}
        for key, action in backend.keyboard():
            description=labels.get(action,action)
            if action.startswith('GoToDesktop '): description='Switch to workspace '+action.split()[-1]
            elif action.startswith('SendToDesktop '): description='Move window to workspace '+action.split()[-1]
            elif action.startswith('wpctl set-volume'): description='Volume up' if action.endswith('+') else 'Volume down'
            elif action.startswith('wpctl set-mute'): description='Mute microphone' if 'SOURCE' in action else 'Mute audio'
            elif action.startswith('brightnessctl'): description=('Keyboard' if 'kbd_backlight' in action else 'Screen')+' brightness '+('up' if action.endswith('+') else 'down')
            model.append([key,description])
        tree = Gtk.TreeView(model=model)
        renderer = Gtk.CellRendererText(editable=True)
        renderer.connect('edited', lambda _, path, text: model.set_value(model.get_iter(path), 0, backend.shortcut_value(text)))
        column=Gtk.TreeViewColumn('Shortcut',renderer)
        column.set_cell_data_func(renderer,lambda _,cell,rows,row,data:cell.set_property('text',backend.shortcut_label(rows[row][0])))
        column.set_min_width(220); tree.append_column(column)
        renderer.connect('editing-started',lambda _,entry,path:entry.set_text(backend.shortcut_label(model[path][0])))
        cell = Gtk.CellRendererText(); cell.set_property('ellipsize', 3)
        column=Gtk.TreeViewColumn('Action',cell,text=1); column.set_expand(True); tree.append_column(column)
        scroll = Gtk.ScrolledWindow(); scroll.set_min_content_height(260); scroll.add(tree)
        page.pack_start(scroll, True, True, 0)
        def edit_selected(*_):
            rows,row=tree.get_selection().get_selected()
            if row is not None:
                self.edit_fields('Edit shortcut',[('Shortcut',backend.shortcut_label(rows[row][0]))],lambda values: rows.set_value(row,0,backend.shortcut_value(values[0])))
        edit=Gtk.Button(label='Edit selected shortcut',halign=Gtk.Align.START); edit.connect('clicked',edit_selected); page.pack_start(edit,False,False,0)
        self.selection_actions(tree, [(edit, None)])
        self.note(page, 'Custom shortcuts: add a key combination and the command to launch. Double-click either field to edit. Commands run as your user when you press the shortcut.')
        custom = Gtk.ListStore(str, str)
        for key, command in backend.custom_keyboard():
            custom.append([key, command])
        custom_tree = Gtk.TreeView(model=custom)
        for index, title in enumerate(('Shortcut', 'Command')):
            cell = Gtk.CellRendererText(editable=True)
            cell.connect('edited', lambda _, path, text, col=index: custom.set_value(custom.get_iter(path), col, backend.shortcut_value(text) if col==0 else text))
            column=Gtk.TreeViewColumn(title,cell,text=index)
            column.set_min_width(220 if index==0 else 250); column.set_expand(index==1)
            if index==0:
                column.set_cell_data_func(cell,lambda _,renderer,rows,row,data:renderer.set_property('text',backend.shortcut_label(rows[row][0])))
                cell.connect('editing-started',lambda _,entry,path:entry.set_text(backend.shortcut_label(custom[path][0])))
            custom_tree.append_column(column)
        custom_scroll = Gtk.ScrolledWindow()
        custom_scroll.set_min_content_height(140)
        custom_scroll.add(custom_tree)
        page.pack_start(custom_scroll, True, True, 0)
        controls = Gtk.Box(spacing=12)
        add = Gtk.Button(label='Add shortcut')
        def add_custom(_):
            row = custom.append(['', ''])
            custom_tree.set_cursor(custom.get_path(row), custom_tree.get_column(0), True)
        add.connect('clicked', add_custom)
        remove = Gtk.Button(label='Remove selected')
        def remove_custom(_):
            selected_model, row = custom_tree.get_selection().get_selected()
            if row is not None:
                selected_model.remove(row)
        remove.connect('clicked', remove_custom)
        def edit_custom(*_):
            rows,row=custom_tree.get_selection().get_selected()
            if row is None:return
            def commit(values):
                rows.set_value(row,0,backend.shortcut_value(values[0])); rows.set_value(row,1,values[1])
            self.edit_fields('Edit custom shortcut',[('Shortcut',backend.shortcut_label(rows[row][0])),('Command',rows[row][1])],commit)
        edit=Gtk.Button(label='Edit selected'); edit.connect('clicked',edit_custom)
        self.selection_actions(custom_tree, [(edit, None), (remove, None)])
        controls.pack_start(edit,False,False,0)
        controls.pack_start(add, False, False, 0)
        controls.pack_start(remove, False, False, 0)
        page.pack_start(controls, False, False, 0)
        def apply():
            keys = [row[0] for row in model]
            custom_rows = [(row[0], row[1]) for row in custom]
            backend.validate_shortcuts([*keys, *(key for key,_ in custom_rows)])
            def job():
                nonlocal keyboard_source
                backend.save_keyboard(keys,custom_rows,keyboard_source)
                keyboard_source=backend.keyboard_source()
            return job
        self.button(page, 'Apply shortcuts', apply)

    def overview_dock(self, page):
        source, options, items = backend.dock_settings()
        enabled = self.toggle(page, 'Show dock in overview', options['enabled'])
        self.note(page, 'Apply your changes, then reopen the overview.')
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page.pack_start(content, True, True, 0)
        flags = {'enabled': enabled}
        display = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        display_options = Gtk.Expander(label='Display options')
        display_options.add(display)
        for key, label in [('show_labels', 'Show launcher names'), ('show_clock', 'Show clock'), ('show_battery', 'Show battery status')]:
            flags[key] = self.toggle(display, label, options[key])
        self.note(display, 'Default-program launchers follow your selected apps. Commands run as your user without a shell. Hiding the dock keeps window previews available.')
        model = Gtk.ListStore(str, str, str)
        for item in items: model.append(item)
        tree = Gtk.TreeView(model=model)
        for index, title in enumerate(('Name', 'Command')):
            cell = Gtk.CellRendererText(); cell.set_property('ellipsize', 3)
            column = Gtk.TreeViewColumn(title, cell, text=index)
            column.set_min_width(130 if index == 0 else 220)
            column.set_expand(index == 1); column.set_resizable(True)
            tree.append_column(column)
        scroll = Gtk.ScrolledWindow(); scroll.set_min_content_height(180); scroll.add(tree)
        content.pack_start(scroll, True, True, 0)
        def edit_item(add=False):
            rows, row = tree.get_selection().get_selected()
            if not add and row is None: return
            if add and len(model) >= 12:
                self.report('Dock supports up to 12 launchers.', error=True); return
            dialog = Gtk.Dialog(title='Add launcher' if add else 'Edit launcher', transient_for=self.window, modal=True)
            dialog.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Add' if add else 'Save', Gtk.ResponseType.OK)
            dialog.set_default_size(440, -1)
            fields = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); fields.set_border_width(16)
            dialog.get_content_area().add(fields)
            presets = Gtk.ComboBoxText()
            for i, item in enumerate(backend.DOCK_PRESETS): presets.append(str(i), item[0] + (' (default program)' if item[1].startswith('erdos-launch ') else ''))
            presets.append('custom', 'Custom command')
            name, command = Gtk.Entry(), Gtk.Entry()
            icons = Gtk.ComboBoxText()
            for icon in backend.DOCK_ICONS: icons.append(icon, icon.replace('wifi', 'Wi-Fi').title())
            error_label = Gtk.Label(xalign=0, wrap=True)
            error_label.get_style_context().add_class('error')
            for label, widget in [('Launcher', presets), ('Name', name), ('Command', command), ('Icon', icons)]:
                caption = Gtk.Label(label=label, xalign=0); caption.set_mnemonic_widget(widget)
                widget.get_accessible().set_name(label)
                fields.pack_start(caption, False, False, 0)
                fields.pack_start(widget, False, False, 0)
            choose_app = Gtk.Button(label='Choose installed application…', halign=Gtk.Align.START)
            def installed(*_):
                chooser = Gtk.AppChooserDialog(content_type='application/octet-stream', transient_for=dialog, modal=True)
                chooser.get_widget().set_show_all(True)
                if chooser.run() == Gtk.ResponseType.OK:
                    app = chooser.get_app_info()
                    filename = app.get_filename() if app and isinstance(app, Gio.DesktopAppInfo) else None
                    if filename:
                        presets.set_active_id('custom'); name.set_text(app.get_display_name())
                        command.set_text('gio launch ' + GLib.shell_quote(filename)); icons.set_active_id('application')
                chooser.destroy()
            choose_app.connect('clicked', installed)
            fields.pack_start(choose_app, False, False, 0)
            fields.pack_start(error_label, False, False, 0)
            for entry in (name, command): entry.set_activates_default(True)
            dialog.set_default_response(Gtk.ResponseType.OK)
            def choose(*_):
                selected = presets.get_active_id()
                if selected and selected != 'custom':
                    label, text, icon = backend.DOCK_PRESETS[int(selected)]
                    name.set_text(label); command.set_text(text); icons.set_active_id(icon)
            presets.connect('changed', choose)
            presets.set_active_id('0' if add else 'custom')
            if not add:
                name.set_text(rows[row][0]); command.set_text(rows[row][1]); icons.set_active_id(rows[row][2])
            if icons.get_active_id() is None: icons.set_active_id('application')
            dialog.show_all()
            while dialog.run() == Gtk.ResponseType.OK:
                try: values = backend.validate_dock_item(name.get_text(), command.get_text(), icons.get_active_id())
                except ValueError as error: error_label.set_text(str(error)); continue
                if add:
                    added = model.append(values); tree.get_selection().select_iter(added)
                else:
                    for index, value in enumerate(values): rows.set_value(row, index, value)
                break
            dialog.destroy()
        def remove():
            _, row = tree.get_selection().get_selected()
            if row is not None: model.remove(row)
        def move(direction):
            _, row = tree.get_selection().get_selected()
            if row is not None:
                index = model.get_path(row).get_indices()[0] + direction
                if 0 <= index < len(model): model.swap(row, model.get_iter(Gtk.TreePath.new_from_indices([index])))
        buttons = Gtk.Box(spacing=8)
        selection = []
        for label, callback in [('Add', lambda: edit_item(True)), ('Edit', edit_item), ('Remove', remove), ('Up', lambda: move(-1)), ('Down', lambda: move(1))]:
            button = Gtk.Button(label=label); button.connect('clicked', lambda _, callback=callback: callback())
            buttons.pack_start(button, False, False, 0)
            if label != 'Add': selection.append((button, {'Up': -1, 'Down': 1}.get(label)))
        self.selection_actions(tree, selection)
        tree.get_accessible().set_name('Overview dock launchers')
        content.pack_start(buttons, False, False, 0)
        content.pack_start(display_options, False, False, 0)
        tree.connect('row-activated', lambda *_: edit_item())
        content.set_sensitive(enabled.get_active())
        enabled.connect('notify::active', lambda *_: content.set_sensitive(enabled.get_active()))
        def apply():
            values = {key: widget.get_active() for key, widget in flags.items()}
            entries = [tuple(row) for row in model]
            def job():
                nonlocal source
                message = backend.save_dock(source, values, entries)
                source = backend.dock_source()
                return message
            return job
        self.button(page, 'Apply overview dock', apply)

    def menu(self, page):
        prefs = backend.preferences()
        touchpad = self.toggle(page, 'Three-finger tap/click opens menu', prefs['menu_touchpad'])
        mouse = self.toggle(page, 'Super + right-click opens menu anywhere', prefs['menu_mouse'])
        self.note(page, 'Three-finger menu replaces touchpad middle-click. It requires tap-to-click or clickfinger support. Mouse middle-click stays unchanged. Desktop right-click and Super + Space remain available.')
        self.button(page, 'Apply menu triggers', lambda: (lambda a=touchpad.get_active(), b=mouse.get_active(): backend.menu_triggers(a, b)))
        source, entries = backend.menu_entries()
        self.note(page, 'Edit the desktop right-click menu. Double-click a name or command. Applications stays automatic; submenu contents and built-in actions are preserved. Changes take effect when you apply.')
        model = Gtk.ListStore(str, str, str, str)
        for entry in entries:
            model.append(entry)
        tree = Gtk.TreeView(model=model)
        for index, title in enumerate(('Name', 'Command', 'Type')):
            cell = Gtk.CellRendererText(editable=index < 2)
            cell.set_property('ellipsize', 3)
            if index < 2:
                cell.connect('edited', lambda _, path, text, col=index: model.set_value(model.get_iter(path), col, text))
            column = Gtk.TreeViewColumn(title, cell, text=index)
            column.set_resizable(True)
            column.set_min_width((140,220,100)[index])
            column.set_expand(index==1)
            if index==2:
                column.set_cell_data_func(cell,lambda _,renderer,rows,row,data:renderer.set_property('text',{'Built-in / submenu':'Built-in','Command':'Command','Separator':'Separator'}[rows[row][2]]))
            if index == 1:
                column.set_cell_data_func(cell, lambda _, renderer, rows, row, data: renderer.set_property('editable', rows[row][2] == 'Command'))
            tree.append_column(column)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(300)
        scroll.add(tree)
        page.pack_start(scroll, True, True, 0)
        controls = Gtk.Box(spacing=8)
        def edit_item():
            rows,row=tree.get_selection().get_selected()
            if row is None: return
            fields=[('Name',rows[row][0])]
            if rows[row][2]=='Command': fields.append(('Command',rows[row][1]))
            def commit(values):
                rows.set_value(row,0,values[0])
                if len(values)>1: rows.set_value(row,1,values[1])
            self.edit_fields('Edit menu item',fields,commit)
        def add(kind):
            row = model.append(['New item' if kind == 'Command' else '', '', kind, ''])
            tree.set_cursor(model.get_path(row), tree.get_column(0), kind == 'Command')
        def remove():
            _, row = tree.get_selection().get_selected()
            if row is not None:
                model.remove(row)
        def move(direction):
            _, row = tree.get_selection().get_selected()
            if row is not None:
                index = model.get_path(row).get_indices()[0] + direction
                if 0 <= index < len(model):
                    model.swap(row, model.get_iter(Gtk.TreePath.new_from_indices([index])))
        selection = []
        for title, callback in [('Edit',edit_item), ('Add', lambda: add('Command')), ('Separator', lambda: add('Separator')),
                                ('Delete', remove), ('Up', lambda: move(-1)), ('Down', lambda: move(1))]:
            button = Gtk.Button(label=title)
            button.connect('clicked', lambda _, callback=callback: callback())
            controls.pack_start(button, False, False, 0)
            if title in ('Edit', 'Delete', 'Up', 'Down'): selection.append((button, {'Up': -1, 'Down': 1}.get(title)))
        self.selection_actions(tree, selection)
        page.pack_start(controls, False, False, 0)
        def apply():
            values = [tuple(row) for row in model]
            def job():
                nonlocal source
                backend.save_menu(source, values)
                source = (backend.CONFIG / 'labwc/menu.xml').read_text()
            return job
        self.button(page, 'Apply menu', apply)
        self.note(page, 'Super + I still opens Settings if you remove its menu entry. A .previous backup is saved beside menu.xml. Commands run only when you select an item.')

    def startup_applications(self, page):
        self.note(page, 'Commands run once when you log into labwc. Add one application per line, ending with & so it runs in the background. Keep the existing ErdOS startup commands for desktop features.')
        self.note(page, str(backend.CONFIG / 'labwc/autostart'))
        editor = Gtk.TextView(monospace=True)
        editor.set_wrap_mode(Gtk.WrapMode.NONE)
        editor.set_left_margin(8); editor.set_right_margin(8)
        buffer = editor.get_buffer()
        source = backend.startup_file()
        buffer.set_text(source)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(280)
        scroll.add(editor)
        page.pack_start(scroll, True, True, 0)
        buffer.set_modified(False)
        def save():
            nonlocal source
            content = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
            # Syntax checking is quick and never executes the commands.
            message = backend.save_startup(source, content)
            source = backend.startup_file()
            buffer.set_modified(False)
            return message
        self.button(page, 'Save startup commands', save)
        def reload():
            nonlocal source
            if buffer.get_modified():
                dialog = Gtk.MessageDialog(transient_for=self.window, modal=True,
                    message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.OK_CANCEL,
                    text='Discard unsaved startup changes?')
                answer = dialog.run(); dialog.destroy()
                if answer != Gtk.ResponseType.OK:
                    return 'Reload cancelled; your edits are preserved.'
            source = backend.startup_file()
            buffer.set_text(source); buffer.set_modified(False)
            self.reset_groups(page)
            return 'Startup commands reloaded.'
        self.button(page, 'Reload from disk', reload)
        self.note(page, 'Saving checks shell syntax and keeps the previous file as autostart.previous. It does not start applications now. Example: sakura &')

    def gestures(self, page):
        parser = backend.gestures()
        self.note(page, 'One action per swipe. Lower distance triggers sooner; very short distances can trigger accidentally. The native thumbnail switcher has no decorative effects.')
        distance = self.scale(page, 'Swipe distance', 20, 1000, parser.getfloat('swipe','distance'), 10)
        actions = [('none','Disabled'), ('overview-show','Open overview'), ('workspaces-menu','Show workspaces menu'), ('overview-hide','Close overview'),
                   ('window-previous','Previous window'), ('window-next','Next window'),
                   ('workspace-previous','Previous workspace'), ('workspace-next','Next workspace')]
        choices = {}
        for key in ('3_up','3_down','3_left','3_right','4_up','4_down','4_left','4_right'):
            count, direction = key.split('_')
            choices[key] = self.choice(page, f'{count} fingers {direction}', actions, parser.get('bindings',key, fallback='none'))
        def apply():
            value = distance.get_value_as_int(); bindings = {k:w.get_active_id() for k,w in choices.items()}
            return lambda: backend.save_gestures(value, bindings)
        self.button(page, 'Apply gestures', apply)

    def displays(self, page):
        modes_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.pack_start(modes_box, False, False, 0)
        def refresh():
            self.reload_displays(modes_box)
        self.refresh_displays=refresh
        button = Gtk.Button(label='Refresh displays', halign=Gtk.Align.START)
        button.connect('clicked', lambda *_: refresh())
        page.pack_start(button, False, False, 0)
        refresh()
        self.note(page, 'Keep a tested resolution within 15 seconds or the previous layout returns. Saved modes are reused for the same connected displays.')
        self.note(page, 'Automatic layout extends external displays to the right and keeps the laptop primary. Turning it off keeps the current layout and stops automatic rearrangement. Workspaces span all screens.')
        automatic = self.toggle(page, 'Automatically extend connected displays', backend.preferences()['automatic_displays'])
        def apply():
            enabled = automatic.get_active()
            return lambda: backend.display_policy(enabled)
        self.button(page, 'Apply display policy', apply)
        backlights = sorted(Path('/sys/class/backlight').glob('*'))
        if backlights:
            device = backlights[0]
            value = int((device/'brightness').read_text()) * 100 / int((device/'max_brightness').read_text())
            brightness = self.scale(page, 'Screen brightness (%)', 5, 100, value, 5)
            def apply_brightness():
                value = str(brightness.get_value_as_int()) + '%'
                return lambda: backend.run('brightnessctl','-q','-d',device.name,'set',value)
            self.button(page, 'Apply brightness', apply_brightness)
        else:
            self.note(page, 'No controllable screen backlight detected.')

    def reload_displays(self, box):
        for child in box.get_children(): child.destroy()
        self.load_section(box, display_settings.outputs, self.resolution_controls)

    def resolution_controls(self, page, outputs):
        choices = {}
        for output in outputs:
            if not output['mode']:
                self.note(page, output['name'] + ': connected but inactive')
                continue
            choices[output['name']] = self.choice(page,
                output['name'] + (' (primary)' if output['primary'] else ''),
                [(mode, mode) for mode in output['modes']], output['mode'])
        if not choices:
            self.note(page, 'No active display detected.')
            return
        button = Gtk.Button(label='Test resolution', halign=Gtk.Align.START)
        button.connect('clicked', lambda *_: self.test_resolution(
            {name: widget.get_active_id() for name, widget in choices.items()}))
        page.pack_start(button, False, False, 0)

    def test_resolution(self, selections):
        if self.trial_process is not None:
            return
        self.stack.set_sensitive(False)
        self.report('Testing resolution…')
        try:
            self.trial_process = subprocess.Popen(
                [sys.executable, '-B', str(Path(display_settings.__file__))],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                text=True, start_new_session=True)
            process = self.trial_process
            self.close_after_resolution=False
            process.stdin.write(json.dumps(selections) + '\n'); process.stdin.flush()
        except Exception as error:
            self.finish_resolution(self.error_text(error), True)
            return
        def worker():
            try:
                for line in process.stdout:
                    result = json.loads(line)
                    if result['status'] == 'ready':
                        GLib.idle_add(self.confirm_resolution, result['seconds'])
                    else:
                        message = {'kept':'Resolution saved.', 'restored':'Previous resolution restored.'}.get(
                            result['status'], result.get('message', 'Display change failed.'))
                        process.wait()
                        GLib.idle_add(self.finish_resolution, message, result['status']=='error')
                        return
                process.wait()
                GLib.idle_add(self.finish_resolution, 'Display helper ended unexpectedly. The previous layout may not have been restored.', True)
            except Exception as error:
                # EOF tells the independent helper to roll back even if GTK fails.
                process.stdin.close()
                GLib.idle_add(self.finish_resolution, self.error_text(error), True)
        threading.Thread(target=worker, daemon=True).start()

    def confirm_resolution(self, seconds):
        if self.trial_process is None:
            return
        area = Gdk.Display.get_default().get_monitor_at_window(self.window.get_window()).get_workarea()
        self.window.resize(min(820, max(400, area.width-24)), min(580, max(300, area.height-32)))
        self.window.move(area.x+12, area.y+16)
        deadline = time.monotonic() + seconds
        def tick():
            remaining = max(0, int(deadline - time.monotonic()))
            self.resolution_label.set_text(f'Keep this resolution? Reverting in {remaining} seconds.')
            return self.trial_process is not None and remaining > 0
        tick()
        self.resolution_bar.set_sensitive(True)
        self.resolution_bar.show_all()
        self.trial_timer = GLib.timeout_add_seconds(1, tick)

    def answer_resolution(self, answer):
        process = self.trial_process
        if process is not None:
            self.resolution_bar.set_sensitive(False)
            try:
                process.stdin.write(answer + '\n'); process.stdin.flush()
            except (OSError, ValueError):
                pass  # The helper may already have restored the timed-out change.

    def finish_resolution(self, message, error=False):
        if self.trial_timer:
            # A timer may already have expired; look it up before removing it.
            if GLib.MainContext.default().find_source_by_id(self.trial_timer):
                GLib.source_remove(self.trial_timer)
            self.trial_timer = None
        if self.trial_process:
            self.trial_process.stdin.close()
            self.trial_process.stdout.close()
        self.trial_process = None
        self.resolution_bar.hide()
        self.stack.set_sensitive(True)
        self.report(message,error=error)
        if getattr(self,'close_after_resolution',False):
            self.close_after_resolution=False; self.window.close()
        else: self.refresh_displays()

    def load_section(self, page, fetch, populate, on_error=None):
        generation=getattr(page,'load_generation',0)+1
        page.load_generation=generation
        window=self.window
        loading = self.note(page, 'Loading…')
        def finish(data, error):
            if self.window is not window or getattr(page,'load_generation',None)!=generation:
                return False
            loading.destroy()
            if error:
                if on_error: on_error(error)
                notice = self.note(page, f'Could not load this section: {error}')
                retry = Gtk.Button(label='Retry', halign=Gtk.Align.START)
                def again(*_):
                    notice.destroy(); retry.destroy()
                    self.load_section(page, fetch, populate, on_error)
                retry.connect('clicked', again)
                page.pack_start(retry, False, False, 0)
            else:
                try:
                    populate(page, data)
                except Exception as failure:
                    self.note(page, f'Could not load this section: {self.error_text(failure)}')
            page.show_all()
        def worker():
            try:
                data = fetch()
            except Exception as error:
                GLib.idle_add(finish, None, self.error_text(error))
            else:
                GLib.idle_add(finish, data, None)
        threading.Thread(target=worker, daemon=True).start()

    def sound(self, page):
        content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=16)
        page.pack_start(content,False,False,0)
        def refresh():
            dirty=[g for g in self.groups if g['page'] is content and self.group_values(g)!=g['saved']]
            if dirty:
                self.report('Apply or revert your audio edits before refreshing.',error=True); return
            self.groups=[g for g in self.groups if g['page'] is not content]
            for child in content.get_children(): child.destroy()
            self.load_section(content, backend.audio_nodes, self.sound_controls)
        button=Gtk.Button(label='Refresh devices',halign=Gtk.Align.START)
        button.connect('clicked',lambda *_:refresh()); page.pack_start(button,False,False,0)
        refresh()

    def sound_controls(self, page, devices):
        if not devices:
            self.note(page,'No audio devices detected. Connect a device and refresh.'); return
        self.note(page,'Choose a device to see its current volume. Existing apps may keep using their previous device.')
        for kind,title,target in [('Audio/Sink','Output','@DEFAULT_AUDIO_SINK@'),('Audio/Source','Microphone','@DEFAULT_AUDIO_SOURCE@')]:
            matches=[(i,n) for i,n,k in devices if k==kind]
            if not matches:
                self.note(page,f'No {title.lower()} device detected.'); continue
            choice=self.choice(page,title+' device',[(target,'Current default'),*matches],target)
            volume=self.scale(page,title+' volume (%)',0,100,0)
            mute=self.toggle(page,title+' muted',False)
            detail=self.note(page,'Reading current volume…')
            state={'revision':0,'ready':False}
            def apply(choice=choice,volume=volume,mute=mute,state=state):
                if not state['ready']: raise ValueError('Wait for the selected device to load, or refresh devices.')
                selected,level,silent=choice.get_active_id(),volume.get_value_as_int(),mute.get_active()
                def job():
                    if not selected.startswith('@'): backend.run('wpctl','set-default',selected)
                    backend.run('wpctl','set-volume','-l','1.0',selected,str(level/100))
                    backend.run('wpctl','set-mute',selected,str(int(silent)))
                    return 'Audio settings applied.'
                return job
            button=self.button(page,'Apply '+title.lower(),apply)
            group=self.groups[-1]
            group['available']=lambda state=state: state['ready']
            def changed(*_,choice=choice,volume=volume,mute=mute,detail=detail,state=state,group=group):
                state['revision']+=1; revision=state['revision']; state['ready']=False
                volume.set_sensitive(False); mute.set_sensitive(False)
                selected=choice.get_active_id(); detail.set_text('Reading current volume…')
                self.group_update(group)
                window=self.window
                def finish(info,error):
                    if self.window is not window or revision!=state['revision'] or not choice.get_parent():return False
                    if error:
                        detail.set_text(self.error_text(error)); self.report(self.error_text(error),error=True)
                    else:
                        try: level=float(info.split()[1])*100
                        except (ValueError,IndexError):
                            detail.set_text('Could not read the device volume. Refresh devices to try again.'); return False
                        volume.set_value(min(100,max(0,round(level))))
                        mute.set_active('[MUTED]' in info)
                        state['ready']=True; volume.set_sensitive(True); mute.set_sensitive(True)
                        detail.set_text('Current device volume loaded.')
                        # Switching devices is a pending default-device change; loading
                        # its volume does not count as a user volume edit.
                        for widget in (volume,mute):
                            group['saved'][group['controls'].index(widget)]=self.control_value(widget)
                    self.group_update(group)
                    return False
                def worker():
                    try: info=backend.run('wpctl','get-volume',selected)
                    except Exception as error: GLib.idle_add(finish,None,error)
                    else: GLib.idle_add(finish,info,None)
                threading.Thread(target=worker,daemon=True).start()
            choice.connect('changed',changed); changed()

    def every(self, seconds, callback):
        callback()
        def tick():
            if self.window is None:
                return False
            callback()
            return True
        timer = GLib.timeout_add_seconds(seconds, tick)
        def stop(*_):
            if GLib.MainContext.default().find_source_by_id(timer):
                GLib.source_remove(timer)
        self.window.connect('destroy', stop)

    def power(self, page):
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.pack_start(content, False, False, 0)
        def update():
            if self.stack.get_visible_child_name() != 'Power' and content.get_children():
                return
            for child in content.get_children():
                child.destroy()
            batteries, connected = backend.power_info()
            self.note(content, 'External power connected' if connected else 'No external power source reported')
            if not batteries:
                self.note(content, 'No battery detected. This is normal on desktops and in virtual machines.')
            for battery in batteries:
                self.note(content, battery['name'] + ': ' + battery['status'])
                if battery['capacity']:
                    self.note(content, 'Charge: ' + battery['capacity'] + '%')
                if 'health' in battery:
                    self.note(content, f'Health: {battery["health"]}% of design capacity')
                if battery['cycles']:
                    self.note(content, 'Charge cycles: ' + battery['cycles'])
            content.show_all()
        self.every(10, update)
        self.note(page, 'Battery health and cycle counts appear only when reported by the hardware. This page does not change charging limits or suspend policy.')

    def date_time(self, page):
        current = self.note(page, '')
        entry = self.row(page, 'System time zone', Gtk.Entry())
        preview = self.note(page, '')
        zones = set()
        def fetch():
            return backend.run('timedatectl','list-timezones').splitlines(), backend.run('timedatectl','show','--property=Timezone','--value')
        def loaded(_page, data):
            names, selected = data
            zones.update(names)
            model = Gtk.ListStore(str)
            for name in names:
                model.append([name])
            completion = Gtk.EntryCompletion(model=model, text_column=0)
            completion.set_minimum_key_length(1)
            completion.set_match_func(lambda _, key, iterator, *extra: key.lower() in model[iterator][0].lower())
            entry.set_completion(completion)
            entry.set_text(selected)
            self.reset_groups(page)
        self.load_section(page, fetch, loaded)
        def tick():
            if self.stack.get_visible_child_name() != 'Date & Time' and current.get_text():
                return
            time.tzset()
            current.set_text('Current system time: ' + datetime.now().astimezone().strftime('%a, %b %d, %Y  %I:%M:%S %p %Z'))
            try:
                selected = entry.get_text().strip()
                preview.set_text('Selected zone: ' + datetime.now(ZoneInfo(selected)).strftime('%I:%M:%S %p %Z') if selected in zones else 'Type a city or region, such as America/New_York.')
            except (ValueError, KeyError):
                preview.set_text('Choose a valid time zone.')
        self.every(1,tick)
        self.note(page, 'The system time zone applies to all users. Administrator authentication may be requested. This changes how time is displayed, not the clock itself.')
        def apply():
            selected = entry.get_text().strip()
            if selected not in zones:
                raise ValueError('Select a time zone from the suggestions.')
            return lambda: backend.run('timedatectl','set-timezone',selected,timeout=120)
        self.button(page, 'Apply time zone', apply)
        sync_status = self.note(page, 'Checking automatic time synchronization…')
        def sync_fetch():
            values = dict(line.split('=', 1) for line in backend.run('timedatectl', 'show',
                '--property=NTP', '--property=NTPSynchronized').splitlines() if '=' in line)
            return 'Automatic time sync: ' + ('on' if values.get('NTP') == 'yes' else 'off') + '. Clock synchronized: ' + values.get('NTPSynchronized', 'unknown') + '.'
        sync_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); page.pack_start(sync_box,False,False,0)
        def refresh_sync():
            for child in sync_box.get_children(): child.destroy()
            sync_status.set_text('Checking automatic time synchronization…')
            self.feedback.hide()
            def loaded(_,value):
                sync_status.set_text(value)
            self.load_section(sync_box,sync_fetch,loaded,lambda _:sync_status.set_text('Automatic time synchronization is unavailable.'))
        refresh_sync()
        self.button(page, 'Refresh sync status', refresh_sync)
        self.button(page, 'Enable automatic time sync', lambda: lambda: backend.run('timedatectl', 'set-ntp', 'true', timeout=120))
        self.note(page, 'Time synchronization starts automatically when a time server is reachable. After enabling it, refresh the status. If APT says a signature is not valid yet, wait for synchronization before updating packages.')


    def bluetooth(self, page):
        from bluetooth_settings import Bluetooth
        self.bluetooth_page = Bluetooth(self, page)

    def network(self, page):
        from network_settings import Network
        self.network_page = Network(self, page)


if __name__ == '__main__':
    if backend.os.geteuid() == 0:
        sys.exit('Open Settings as your desktop user, not root.')
    Settings().run(sys.argv)
