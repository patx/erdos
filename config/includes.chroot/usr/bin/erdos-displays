#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""One-shot output layout, invoked at login and compositor hotplug events."""
import fcntl
import os
from pathlib import Path
import sys
sys.dont_write_bytecode=True
sys.path.insert(0,str(Path(__file__).resolve().parent.parent/'lib/erdos'))
from display_settings import automatic
runtime=Path(os.environ['XDG_RUNTIME_DIR'])
with (runtime/'erdos-displays.lock').open('a') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    automatic()
