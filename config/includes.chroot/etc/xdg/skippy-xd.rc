# ErdOS overview defaults. Skippy runs on demand, without a compositor or daemon.
[system]
clientList = _NET_CLIENT_LIST
pseudoTrans = true

[layout]
exposeLayout = rect
exposeCycleDesktops = true
upscaleWindows = false
minDistance = 30

[appearance]
animationDuration = 0
background = #101719cc
includeFrame = true

[multimonitor]
exposeOnCurrentMonitor = false

[label]
show = all
option = windowTitle
font = DejaVu Sans-10

[highlight]
tint = #159bff
tintOpacity = 64
tintBorder = 4

[panel]
show = false

[desktop]
show = false

[bindings]
keysCancel = Escape
keysSelect = Return space
moveMouse = false
